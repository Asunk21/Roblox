-- KEYBOARD SHORTCUT - Increase/Decrease MultiplyTimes dengan tombol - dan +
local keyDownConn = uis.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    -- Tombol - (Minus) untuk turunkan multiplytimes
    if input.KeyCode == Enum.KeyCode.Minus or input.KeyCode == Enum.KeyCode.KeypadMinus then
        local newValue = _G.Config.multiplytimes - 1
        if newValue >= 1 then
            _G.Config.multiplytimes = newValue
            if _G.UpdateGatling then
                _G.UpdateGatling({multiplytimes = newValue})
            end
            -- Update GUI
            updateMultiplyTimesGUI(newValue)
            -- Tampilkan notifikasi
            showNotification("⚡ Multiply Times", "Decreased to: " .. newValue, 3)
        else
            showNotification("⚠️ Multiply Times", "Minimum value is 1", 2)
        end
    end
    
    -- Tombol + (Plus/Equals) untuk naikkan multiplytimes
    if input.KeyCode == Enum.KeyCode.Equals or input.KeyCode == Enum.KeyCode.KeypadPlus then
        local newValue = _G.Config.multiplytimes + 1
        if newValue <= 100 then
            _G.Config.multiplytimes = newValue
            if _G.UpdateGatling then
                _G.UpdateGatling({multiplytimes = newValue})
            end
            -- Update GUI
            updateMultiplyTimesGUI(newValue)
            -- Tampilkan notifikasi
            showNotification("⚡ Multiply Times", "Increased to: " .. newValue, 3)
        else
            showNotification("⚠️ Multiply Times", "Maximum value is 100", 2)
        end
    end
end)
table.insert(_G.GatlingConnections, keyDownConn)

