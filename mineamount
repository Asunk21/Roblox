-- ========== FUNGSI UNTUK MEMBUAT MATERIAL BUTTON ==========
local materialButtons = {}
local selectedMaterial = materialList[1] or "Weathered Wood"

local function createMaterialButtons()
    -- Hapus button lama jika ada
    for _, btn in pairs(materialButtons) do
        btn:Destroy()
    end
    materialButtons = {}
    
    -- Buat button baru untuk setiap material
    for i, mat in ipairs(materialList) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.Position = UDim2.new(0, 0, 0, (i-1) * 30)
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        btn.Text = mat
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 14
        btn.Font = Enum.Font.Gotham
        btn.BorderSizePixel = 0
        btn.Parent = dropdownList
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        -- Hover effect
        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end)
        
        -- Select material
        btn.MouseButton1Click:Connect(function()
            selectedMaterial = mat
            materialDropdown.Text = mat
            dropdownList.Visible = false
            dropdownVisible = false
        end)
        
        materialButtons[mat] = btn
    end
    
    -- Update dropdown size
    dropdownList.Size = UDim2.new(0, 150, 0, #materialList * 30)
end

-- Panggil fungsi untuk membuat button
createMaterialButtons()

-- ========== FUNGSI TAMBAH MATERIAL (PANGGIL INI UNTUK TAMBAH MATERIAL) ==========
function addMaterial(materialName)
    if not table.find(materialList, materialName) then
        table.insert(materialList, materialName)
        createMaterialButtons() -- Refresh dropdown
        print("Material '" .. materialName .. "' telah ditambahkan!")
        return true
    else
        print("Material '" .. materialName .. "' sudah ada!")
        return false
    end
end

function removeMaterial(materialName)
    local index = table.find(materialList, materialName)
    if index then
        table.remove(materialList, index)
        createMaterialButtons() -- Refresh dropdown
        if selectedMaterial == materialName then
            selectedMaterial = materialList[1] or "Weathered Wood"
            materialDropdown.Text = selectedMaterial
        end
        print("Material '" .. materialName .. "' telah dihapus!")
        return true
    else
        print("Material '" .. materialName .. "' tidak ditemukan!")
        return false
    end
end

