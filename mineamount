-- Fungsi untuk mengubah semua ProximityPrompt menjadi instant
local function setInstantProximity()
    for i, v in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            v.HoldDuration = 0
        end
    end
end

-- Fungsi untuk mengembalikan ProximityPrompt ke default
local function resetProximity()
    for i, v in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            v.HoldDuration = 1
        end
    end
end

-- Panggil fungsi pertama kali
setInstantProximity()

