end)

_G.UpdateGatling = function(newConfig)
    for k, v in pairs(newConfig) do
        if _G.Config[k] ~= nil then
            _G.Config[k] = v
        end
    end
    -- Update GUI if multiplytimes changed
    if newConfig.multiplytimes then
        updateMultiplyTimesGUI(newConfig.multiplytimes)
    end
    -- Update auto fire status
    if _G.Config.auto_fire then
        if not _G.GatlingAutoFire then
            _G.GatlingAutoFire = true
            task.spawn(function()
                while _G.GatlingAutoFire and _G.Config.enabled do
                    if not firing then
                        sendFirePacket()
                    end
                    task.wait(_G.Config.gatlingcooldown)
                end
            end)
        end
    else
        _G.GatlingAutoFire = false
    end
end

