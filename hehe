local running = false
local thread = nil
local mode = 1

local function updateModeUI()
    if mode == 1 then
        mode1Btn.BackgroundColor3 = Color3.fromRGB(120, 200, 80)
        mode1Stroke.Color = Color3.fromRGB(40, 100, 20)
        mode2Btn.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        mode2Stroke.Color = Color3.fromRGB(90, 90, 90)
    else
        mode1Btn.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        mode1Stroke.Color = Color3.fromRGB(90, 90, 90)
        mode2Btn.BackgroundColor3 = Color3.fromRGB(120, 200, 80)
        mode2Stroke.Color = Color3.fromRGB(40, 100, 20)
    end
end

local function start()
    running = true
    btn.Text = "ON"
    btn.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
    btnStroke.Color = Color3.fromRGB(120, 20, 20)
    status.Text = "Running... (Mode " .. mode .. ")"
    status.TextColor3 = Color3.fromRGB(200, 40, 40)
    local currentMode = mode
    thread = task.spawn(function()
        while running do
            if currentMode == 1 then
                pcall(function()
                    ReplicatedStorage.CraftingAyam.Remotes.RequestCraft:InvokeServer("ProcessingStation1")
                end)
                task.wait(1)
                pcall(function()
                    ReplicatedStorage.CraftingAyam.Remotes.SubmitCraft:InvokeServer("ProcessingStation1")
                end)
                task.wait(1)
            else
                pcall(function()
                    ReplicatedStorage.CraftingAyam.Remotes.RequestCraft:InvokeServer("ProcessingStation2")
                end)
                task.wait(1)
                pcall(function()
                    ReplicatedStorage.CraftingAyam.Remotes.SubmitCraft:InvokeServer("ProcessingStation2")
                end)
                task.wait(5)
            end
        end
    end)
end

local function stop()
    running = false
    btn.Text = "OFF"
    btn.BackgroundColor3 = Color3.fromRGB(120, 200, 80)
    btnStroke.Color = Color3.fromRGB(40, 100, 20)
    status.Text = "Idle"
    status.TextColor3 = Color3.fromRGB(90, 60, 0)
    if thread then
        task.cancel(thread)
        thread = nil
    end
end

mode1Btn.MouseButton1Click:Connect(function()
    if running then return end
    mode = 1
    updateModeUI()
end)

mode2Btn.MouseButton1Click:Connect(function()
    if running then return end
    mode = 2
    updateModeUI()
end)

btn.MouseButton1Click:Connect(function()
    if running then stop() else start() end
end)

close.MouseButton1Click:Connect(function()
    stop()
    gui:Destroy()
    script:Destroy()
end)

updateModeUI()
