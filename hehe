local remotes = ReplicatedStorage:WaitForChild("CraftingAyam"):WaitForChild("Remotes")
local requestCraft = remotes:WaitForChild("RequestCraft")
local submitCraft = remotes:WaitForChild("SubmitCraft")

local isRunning = false
local loopThread = nil
local DELAY = 1

local function setStatus(text, color)
    statusLabel.Text = "Status: " .. text
    statusLabel.TextColor3 = color or Color3.fromRGB(180, 180, 180)
end

local function startLoop()
    if isRunning then return end
    isRunning = true
    toggleBtn.Text = "ON"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
    setStatus("Running", Color3.fromRGB(100, 255, 120))

    loopThread = task.spawn(function()
        while isRunning do
            pcall(function()
                requestCraft:InvokeServer("ProcessingStation1")
            end)
task.wait(1)
            pcall(function()
                submitCraft:InvokeServer("ProcessingStation1")
            end)
            task.wait(DELAY)
        end
    end)
end

local function stopLoop()
    isRunning = false
    toggleBtn.Text = "OFF"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    setStatus("Idle", Color3.fromRGB(180, 180, 180))
    if loopThread then
        task.cancel(loopThread)
        loopThread = nil
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopLoop()
    else
        startLoop()
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    stopLoop()
