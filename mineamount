-- ========== DISTANCE SLIDER FUNCTION ==========
sliderButton.MouseButton1Down:Connect(function()
    dragging = true
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        delayDragging = false
    end
end)

RunService.RenderStepped:Connect(function()
    if dragging then
        local sliderPos = slider.AbsolutePosition.X
        local sliderSize = slider.AbsoluteSize.X
        local mouseX = mouse.X
        
        local percent = math.clamp((mouseX - sliderPos) / sliderSize, 0, 1)
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        sliderButton.Position = UDim2.new(percent, -8, 0.5, -8)
        
        distance = math.round(minDistance + (maxDistance - minDistance) * percent)
        distanceValue.Text = tostring(distance)
        distanceLabel.Text = "Distance: " .. tostring(distance)
    end
end)

-- ========== DELAY SLIDER FUNCTION ==========
delaySliderButton.MouseButton1Down:Connect(function()
    delayDragging = true
end)

RunService.RenderStepped:Connect(function()
    if delayDragging then
        local sliderPos = delaySlider.AbsolutePosition.X
        local sliderSize = delaySlider.AbsoluteSize.X
        local mouseX = mouse.X
        
        local percent = math.clamp((mouseX - sliderPos) / sliderSize, 0, 1)
        delaySliderFill.Size = UDim2.new(percent, 0, 1, 0)
        delaySliderButton.Position = UDim2.new(percent, -8, 0.5, -8)
        
        sellDelay = math.round((minDelay + (maxDelay - minDelay) * percent) * 2) / 2
        if sellDelay < 0.5 then sellDelay = 0.5 end
        delayValue.Text = tostring(sellDelay)
        delayLabel.Text = "Sell Delay: " .. tostring(sellDelay) .. "s"
    end
end)

-- ========== AUTO DIG FUNCTION (FIXED) ==========
RunService.Heartbeat:Connect(function()
    if isAutoDigEnabled then
        local character = player.Character
        if character then
            local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
            if humanoidRootPart then
                local digPosition
                
                if digMode == "Cursor" then
                    -- Ambil posisi mouse di 3D
                    local mousePos = mouse.Hit.Position
                    local mouseTarget = mouse.Target
                    
                    -- Jika ada target, ambil posisi target (termasuk ketinggian)
                    if mouseTarget then
                        digPosition = mouseTarget.Position
                    else
                        -- Jika tidak ada target, gunakan posisi mouse dengan Y dari karakter
                        digPosition = Vector3.new(mousePos.X, humanoidRootPart.Position.Y, mousePos.Z)
                    end
                    
                    -- Opsional: tambahkan sedikit offset ke atas agar menggali di permukaan
                    digPosition = digPosition + Vector3.new(0, 2, 0)
                else
                    -- Mode Forward
                    digPosition = humanoidRootPart.Position + humanoidRootPart.CFrame.LookVector * distance
                end
                
                local args = {selectedMaterial, digPosition}
                ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DigRequest"):FireServer(unpack(args))
            end
        end
    end
end)

