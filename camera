local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local useCustomCamera = false
local useCustomSettings = false

local SMOOTH_FACTOR = 0.05

local targetYaw = 0
local targetPitch = 0
local currentYaw = 0
local currentPitch = 0

local currentZoom = 10
local targetZoom = 10
local MIN_ZOOM = 3
local ZOOM_SENSITIVITY = 1

local mouseSensitivity = 0.005

local targetFOV = 70
local currentFOV = 70
local FOV_SMOOTH_FACTOR = 0.1

local function getHeadPosition()
	local character = player.Character
	if not character then
		return camera.Focus.Position
	end

	local head = character:FindFirstChild("Head")
	if head then
		return head.Position
	end

	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart then
		return humanoidRootPart.Position
	end

	return character.PrimaryPart and character.PrimaryPart.Position or Vector3.new()
end

local function enableCustomCamera()
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = currentFOV
end

local function restoreStandardCamera()
	camera.CameraType = Enum.CameraType.Custom
end

local function updateCustomCamera()
	if not useCustomCamera then
		return
	end

	local headPos = getHeadPosition()
	if not headPos then
		return
	end

	currentYaw = currentYaw + (targetYaw - currentYaw) * SMOOTH_FACTOR
	currentPitch = currentPitch + (targetPitch - currentPitch) * SMOOTH_FACTOR
	currentZoom = currentZoom + (targetZoom - currentZoom) * SMOOTH_FACTOR

	local yawRotation = CFrame.Angles(0, currentYaw, 0)
	local pitchRotation = CFrame.Angles(currentPitch, 0, 0)
	local combinedRotation = yawRotation * pitchRotation
	local relativeOffset = combinedRotation * Vector3.new(0, 0, currentZoom)
	local targetCameraCFrame = CFrame.new(headPos + relativeOffset, headPos)

	camera.CFrame = targetCameraCFrame
	camera.CameraType = Enum.CameraType.Custom
end

local function updateFOV()
	currentFOV = currentFOV + (targetFOV - currentFOV) * FOV_SMOOTH_FACTOR

	if useCustomCamera or useCustomSettings then
		camera.FieldOfView = currentFOV
	end
end

UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Delta
		targetYaw = targetYaw - delta.X * mouseSensitivity
		targetPitch = targetPitch - delta.Y * mouseSensitivity

		local MAX_PITCH = math.rad(85)
		targetPitch = math.clamp(targetPitch, -MAX_PITCH, MAX_PITCH)
	end

	if input.UserInputType == Enum.UserInputType.MouseWheel then
		local delta = input.Position.Z
		targetZoom = targetZoom - delta * ZOOM_SENSITIVITY
		targetZoom = math.max(targetZoom, MIN_ZOOM)
	end
end)

RunService.RenderStepped:Connect(function()
	updateFOV()

	if useCustomCamera then
		updateCustomCamera()
	end
end)

player.CharacterAdded:Connect(function(character)
