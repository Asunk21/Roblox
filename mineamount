-- Close dropdown when clicking outside
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if dropdownVisible or modeDropdownVisible then
            local mousePos = Vector2.new(mouse.X, mouse.Y)
            
            if dropdownVisible then
                local dropdownPos = dropdownList.AbsolutePosition
                local dropdownSize = dropdownList.AbsoluteSize
                if not (mousePos.X >= dropdownPos.X and mousePos.X <= dropdownPos.X + dropdownSize.X and
                        mousePos.Y >= dropdownPos.Y and mousePos.Y <= dropdownPos.Y + dropdownSize.Y) then
                    dropdownList.Visible = false
                    dropdownVisible = false
                end
            end
            
            if modeDropdownVisible then
                local modePos = modeList.AbsolutePosition
                local modeSize = modeList.AbsoluteSize
                if not (mousePos.X >= modePos.X and mousePos.X <= modePos.X + modeSize.X and
                        mousePos.Y >= modePos.Y and mousePos.Y <= modePos.Y + modeSize.Y) then
                    modeList.Visible = false
                    modeDropdownVisible = false
                end
            end
        end
    end
end)

